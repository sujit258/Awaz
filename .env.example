# ==============================================================================
# Awaz Environment Variables
# ==============================================================================

# PostgreSQL Connection Strings (e.g. Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler/neondb?sslmode=require"

# JWT Secret for session authentication (min 32 characters)
JWT_SECRET="replace-with-a-secure-random-secret-key-32-chars-min"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# Demo Mode Indicator: "true" to display clear demo labels for mock/seeded data in development
DEMO_MODE="false"

# Production Seeding Lock (defaults to false to protect production database)
ALLOW_PRODUCTION_SEED="false"

# ==============================================================================
# Cloudflare R2 Private Evidence Storage (S3-Compatible)
# Leave unconfigured to safely pause evidence uploads (text-only reports work 100%).
# Never expose credentials to client bundles, API responses, logs, or source control.
# ==============================================================================
# [Config] Cloudflare R2 private bucket name (defaults to "awaz" if omitted)
R2_BUCKET="awaz"

# [Config] Cloudflare R2 S3 API endpoint URL (https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT="https://<cloudflare_account_id>.r2.cloudflarestorage.com"

# [Secret] Cloudflare R2 S3-compatible Access Key ID
R2_ACCESS_KEY_ID=""

# [Secret] Cloudflare R2 S3-compatible Secret Access Key
R2_SECRET_ACCESS_KEY=""

# [Config] Cloudflare R2 region (must be "auto")
R2_REGION="auto"

